# DAMAGE MAPPER (CIVISCOPE) Environment Configuration

# Vision provider. Google AI Studio keys use the native Gemini endpoint.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional alternative: set AI_PROVIDER=openrouter and use an OpenRouter key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Isolated demo only: never accesses the real Supabase database.
# Prefer: npm run dev:demo (keeps real-account mode as the default).
CIVISCOPE_DEMO_MODE=false

# Address lookup for the accepted small-demo Nominatim integration.
# Requests are cached and serialized to at most one per 1.1 seconds per process.
# See https://operations.osmfoundation.org/policies/nominatim/
# Production/serverless: replace with a compatible provider/proxy whose limiter
# and cache are shared across all instances. See docs/DEPLOYMENT.md.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=CIVISCOPE-DamageMapper/1.0 (small civic-response demonstration)
